    "road_types": "data/roads/road_types.json",
    "bridges": "data/roads/bridges.geojson",
    "railways": "data/railways/railways.geojson",
    "buildings": "data/buildings/buildings.geojson",
    "building_types": "data/buildings/building_types.json",
    "waterways": "data/water/waterways.geojson",
    "water_bodies": "data/water/water_bodies.geojson",
    "landuse": "data/landuse/landuse.geojson",
    "landmarks": "data/poi/landmarks.geojson",
    "terrain": "data/terrain/terrain.json",
    "landforms": "data/terrain/landforms.geojson"
  }
